# Caché de recursos estáticos en el CDN de Netlify y en el navegador
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/files/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# El cerebro y las herramientas del proyecto no son páginas de la web
/saber/*
  X-Robots-Tag: noindex, nofollow

/guardas/*
  X-Robots-Tag: noindex, nofollow

/herramientas/*
  X-Robots-Tag: noindex, nofollow

# La propuesta inicial es un borrador de trabajo, no una página de la web
/propuesta/*
  X-Robots-Tag: noindex, nofollow

/EMPIEZA-AQUI.html
  X-Robots-Tag: noindex, nofollow
